# GRIVIO backend — environment template.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# On Render the same variables are set as service environment variables
# (the host injects them; no .env file exists there).

# --- Server ----------------------------------------------------------------
# Port the Express app listens on. Render assigns PORT automatically;
# the local default is 5000.
PORT=5000
# development | production | test. production enables stricter logging.
NODE_ENV=development

# --- Database (Neon / Postgres) ---------------------------------------------
# Connection string. Include sslmode=require in production, e.g.
#   postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Auth -------------------------------------------------------------------
# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates every logged-in session.
JWT_SECRET=

# --- AI (Groq) — server-side only, never shipped to any client ---------------
GROQ_API_KEY=your_groq_api_key_here
# Optional override; empty falls back to the model baked into groq.service.js.
GROQ_MODEL=openai/gpt-oss-120b

# --- CORS -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API, e.g.
#   CORS_ORIGINS=https://grivio.vercel.app,http://localhost:4173
# EMPTY = permissive (local dev: Vite, Flutter emulators, curl).
# Requests without an Origin header (curl, the Flutter app) are always
# allowed — CORS only constrains browsers. See docs/DEPLOYMENT.md.
CORS_ORIGINS=
